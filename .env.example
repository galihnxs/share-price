# Copy to .env (never commit .env)
# SEC requires "Name email" in the User-Agent for every EDGAR request.
SEC_USER_AGENT="Galih Muji Agung galih.nxs@gmail.com"
# Optional: force embedding device (mps | cpu). Default: auto-detect.
EMBED_DEVICE=
# Daily prices (Yahoo blocks Python here). Free key: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
# Optional macro (VIX, dollar, WTI, 10Y-2Y). Free key: https://fredaccount.stlouisfed.org/apikeys
# Without it, ETF proxies on Tiingo are used.
FRED_API_KEY=
